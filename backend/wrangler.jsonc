// Cloudflare Workers set-up for ProtoELN (see docs/deployment.md). One Worker serves the
// website's files and passes /api requests to the API, so both share one address, as in
// development. Secrets (the MongoDB connection string and the ORCID client secret) are set with
// `wrangler secret put`, never written here. The settings at the top are staging's; production
// (protoeln.org) is the "production" environment at the bottom, deployed with --env production.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "protoeln-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "staging.protoeln.org", "custom_domain": true }],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // Any address that isn't a file is a page of the website (Vue Router finds it)
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "Api" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Api"] }],
  "observability": { "enabled": true },
  "vars": {
    "PROTOELN_PUBLIC_URL": "https://staging.protoeln.org",
    "PROTOELN_MONGODB_DATABASE": "protoeln-staging",
    // Staging signs in with the ORCID sandbox, like development
    "PROTOELN_ORCID_BASE_URL": "https://sandbox.orcid.org",
    // Staging can be changed, so everything can be tried (see docs/read-only.md)
    "PROTOELN_READ_ONLY": "false",
    // Anyone can read the projects marked public (see docs/deployment.md)
    "PROTOELN_PUBLIC_READ": "true",
    // Files such as images are kept in R2, in the EU jurisdiction (see "Files" in
    // docs/deployment.md); its access key is a secret
    "PROTOELN_FILES_ENDPOINT": "https://5cee0fb1868d6127bb4c6039b5a9b290.eu.r2.cloudflarestorage.com",
    "PROTOELN_FILES_BUCKET": "protoeln-files-staging",
  },
  "env": {
    // protoeln.org, the public demo. It uses the files, Durable Object class and other settings
    // above, but has its own Worker, address, database, ORCID (the real one, not the sandbox)
    // and secrets. Bindings and settings aren't inherited, so they're repeated here.
    "production": {
      "name": "protoeln",
      "routes": [{ "pattern": "protoeln.org", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "API", "class_name": "Api" }],
      },
      "vars": {
        "PROTOELN_PUBLIC_URL": "https://protoeln.org",
        "PROTOELN_MONGODB_DATABASE": "protoeln",
        "PROTOELN_ORCID_BASE_URL": "https://orcid.org",
        // Every deploy locks it: its data changes only by import (see docs/read-only.md)
        "PROTOELN_READ_ONLY": "true",
        "PROTOELN_PUBLIC_READ": "true",
        "PROTOELN_FILES_ENDPOINT": "https://5cee0fb1868d6127bb4c6039b5a9b290.eu.r2.cloudflarestorage.com",
        "PROTOELN_FILES_BUCKET": "protoeln-files",
      },
    },
  },
}
