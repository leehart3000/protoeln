# Settings for running the API locally. Copy this file to .env (which git ignores) and fill in
# the values; environment variables, if set, take precedence.

# The website's address in the browser (Vite's dev server, which passes /api to the API)
PROTOELN_PUBLIC_URL=http://127.0.0.1:5174

# MongoDB: the connection string from Atlas (Connect → Drivers), and which database to use
PROTOELN_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
PROTOELN_MONGODB_DATABASE=protoeln-dev

# Signing in with ORCID: the sandbox for development. The client needs the redirect URI
# http://127.0.0.1:5174/api/v1/auth/orcid/callback
PROTOELN_ORCID_BASE_URL=https://sandbox.orcid.org
PROTOELN_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
PROTOELN_ORCID_CLIENT_SECRET=

# Optional: site admins by ORCID iD, separated by commas; how long sign-ins last (days)
PROTOELN_SITE_ADMINS=
PROTOELN_SESSION_DAYS=14

# The read-only lock: true refuses every change, from anyone (see docs/read-only.md)
PROTOELN_READ_ONLY=false

# Whether anyone can read the projects marked public, without signing in. Off (false) if left
# out: every project can then be seen only by its members and site admins.
PROTOELN_PUBLIC_READ=true

# Where files (such as images in entries) are kept: an S3-compatible object store, such as
# Cloudflare R2 (see docs/deployment.md). Set all four, or none (then files can't be shown).
# The access key and secret are secrets.
# PROTOELN_FILES_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# PROTOELN_FILES_BUCKET=protoeln-files-dev
# PROTOELN_FILES_ACCESS_KEY_ID=
# PROTOELN_FILES_SECRET_ACCESS_KEY=
# "auto" for R2 (the default); the bucket's region for Amazon S3
# PROTOELN_FILES_REGION=auto
